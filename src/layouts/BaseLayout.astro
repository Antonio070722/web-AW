---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/header.css";

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <!-- CookieConsent -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js"></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{title ? `${title} | AW HUB` : 'AW HUB'}</title>
    <meta name="description" content="AW HUB es tu espacio para aprender tecnología, inteligencia artificial, finanzas y programación de forma clara y práctica.">
    <meta name="keywords" content="tecnología, inteligencia artificial, finanzas, programación, educación digital">
    <meta name="author" content="AW HUB">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://tudominio.com/index.html">

    <link rel="icon" type="image/png" href="/img/logo.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Google Analytics + Consent Mode v2 -->
    <script src="https://www.googletagmanager.com/gtag/js?id=G-DCEVDE89VJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Modo por defecto: NO medir hasta que el usuario acepte
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });

      gtag('js', new Date());
      gtag('config', 'G-DCEVDE89VJ');
    </script>
</head>

<body>
    <Header />
    <slot name="ticker"></slot>

    <main class="page-transition">
        <slot />
    </main>

    <Footer />

    <!-- Inicialización única del banner + conexión con Consent Mode -->
    <script is:inline>
  // Función para actualizar consentimiento de forma segura
  function updateConsent(status) {
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {
        ad_storage: status ? 'granted' : 'denied',
        analytics_storage: status ? 'granted' : 'denied',
        ad_user_data: status ? 'granted' : 'denied',
        ad_personalization: status ? 'granted' : 'denied'
      });
      console.log('Consentimiento actualizado a:', status ? 'granted' : 'denied');
    } else {
      console.warn('gtag no disponible, reintentando en 500ms');
      setTimeout(() => updateConsent(status), 500);
    }
  }

  window.addEventListener("load", function() {
    // Forzar eliminación de cookie anterior para pruebas (borra esto en producción)
    document.cookie = "cookieconsent_status=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    
    window.cookieconsent.initialise({
      palette: {
        popup: { background: "#000000", text: "#ffffff" },
        button: { background: "#007bff", text: "#ffffff" }
      },
      theme: "classic",
      layout: "popup",
      type: "opt-in",
      content: {
        message: "Usamos cookies para mejorar tu experiencia, analizar el uso de la web y mostrar contenido relevante. Estas cookies nos ayudan a entender qué funciona mejor y a optimizar el sitio sin recopilar información sensible. No compartimos tus datos con terceros para fines comerciales externos ni los utilizamos para nada que no esté relacionado con el funcionamiento y la mejora de esta página.",
        dismiss: "Rechazar",
        allow: "Aceptar",
        link: "Más información",
        href: "/politica-de-cookies.html"
      },
      onAccept: function() {
        updateConsent(true);
        // Opcional: forzar reenvío de página_view
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href
          });
        }
      },
      onDecline: function() {
        updateConsent(false);
      }
    });
  });
</script>

    <!-- Scripts propios -->
    <script is:inline src="/js/menu.js" defer></script>
    <script src="/js/carrusel.js" defer></script>

</body>
</html>
