---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Inicio" page="home">
        <!-- Hero principal - Nuevo diseño Grid -->
        <section class="hero">
            <div class="hero-grid">
                <div class="hero-text">
                    <span class="hero-tag">IA · Tecnología · Programación</span>
                    <h1>Entiende el mundo digital,<br>sin tecnicismos.</h1>
                    <p>Guías claras y prácticas sobre inteligencia artificial, programación y tecnología moderna. Para curiosos y autodidactas.</p>
                    <div class="hero-buttons">
                        <a href="temas/todosTemas.html" class="btn btn-primary">Explorar temas →</a>
                        <a href="about.html" class="btn btn-secondary">Conoce más</a>
                    </div>
                </div>
                <div class="hero-image">
                    <div class="hero-visual">
                        <div class="hero-badge">IA · CÓDIGO · TECNOLOGÍA</div>
                        <div class="hero-stats">
                            <div class="hero-stat"><span class="stat-num">50+</span><span class="stat-label">Artículos</span></div>
                            <div class="hero-stat"><span class="stat-num">3</span><span class="stat-label">Áreas</span></div>
                            <div class="hero-stat"><span class="stat-num">100%</span><span class="stat-label">Gratis</span></div>
                        </div>
                        <div class="hero-code-block">
                            <span class="code-line"><span class="c-blue">const</span> <span class="c-green">aprender</span> = () =&gt; &#123;</span>
                            <span class="code-line">&nbsp;&nbsp;<span class="c-blue">return</span> <span class="c-orange">"IA + código claro"</span>;</span>
                            <span class="code-line">&#125;;</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
                <div class="hero-latest">
                    <div class="latest-panel">
                        <h2>📌 Últimos artículos</h2>
                                
                    <div id="latest-articles"></div> <!--PARA MODIFICAR O AÑADIR ARTICULOS EN paginacion-articulos.js -->

                    <div class="pagination">
                        <button onclick="changePage(1)">1</button>
                        <button onclick="changePage(2)">2</button>
                        <button onclick="changePage(3)">3</button> 
                        <!--<button onclick="changePage(4)">4</button>--> 
                    </div>
                                
                </div>
            </div>

        <!-- Carrusel de temas (Qué puedes encontrar aquí) -->
        <section class="what-you-find">
            <div class="container">
                <h2 class="section-title">✨ Qué puedes encontrar aquí</h2>
                <div class="que-carousel">
                    <button class="que-arrow que-prev" aria-label="Anterior">◄</button>
                    <div class="que-track" id="queTrack">
                        <div class="que-card">
                            <h3>💻 Tecnología</h3>
                            <p>Las innovaciones <strong>tecnológicas</strong> que están cambiando el mundo, explicadas sin sensacionalismos y con ejemplos cotidianos.</p>
                            <a href="temas/tecnologia" class="card-link">Descubrir →</a>
                        </div>
                        <div class="que-card">
                            <h3>🧠 Inteligencia Artificial</h3>
                            <p>Descubre qué es la IA, tipos de Inteligencia Artificial, cómo funciona y hacia dónde se dirige. <strong>Explicaciones claras</strong> sin tecnicismos innecesarios.</p>
                            <a href="temas/inteligencia-artificial-ia" class="card-link">Descubrir →</a>
                        </div>
                        <div class="que-card">
                            <h3>🐍 Programación</h3>
                            <p>Aprende a programar <strong>en Java</strong> desde cero con <strong>guías prácticas</strong>, ejemplos reales y trucos que te ahorrarán horas de frustración.</p>
                            <a href="temas/progr.html" class="card-link">Descubrir →</a>
                        </div>
                        <div class="que-card">
                            <h3>📚 Todos los temas disponibles</h3>
                            <p>Desarrollo personal, productividad y mucho contenido en camino.</p>
                            <a href="temas/todosTemas" class="card-link">Explorar todo →</a>
                        </div>
                    </div>
                    <button class="que-arrow que-next" aria-label="Siguiente">►</button>
                </div>
            </div>
        </section>

        <!-- Sección Por qué existe esta web (estilo testimonio) -->
        <section class="mission-section">
            <div class="container mission-box">
                <div class="mission-quote">
                    <span class="quote-icon">“</span>
                    <p>Democratizar el conocimiento, sin jergas técnicas ni barreras. Que cualquier persona pueda
                        entender cómo funciona el mundo digital.</p>
                    <a href="/about" class="btn-outline-creator">Conoce al creador</a>
                </div>
                

                <div class="mission-text">
                    <h2>Educación tecnológica clara, práctica y para todos</h2>
                    <p>... Por eso aquí <strong>hablamos claro, con ejemplos reales y cero rollo</strong>. 
Encontrarás <strong>guías de Java paso a paso</strong>, explicaciones sobre <strong>inteligencia artificial desde cero</strong>, 
y análisis de tecnologías como Neuralink o las baterías de sodio. 
Cada artículo está pensado para que entiendas conceptos complejos y <strong>los apliques</strong>.</p>
                    <a href="/temas/todosTemas" class="btn-outline">Comienza aquí →</a>
                </div>
            </div>
        </section>

    <button id="backToTop" class="back-to-top" aria-label="Volver arriba">↑</button>
    <!--<script is:inline src="/js/carrusel.js"></script> -->
        <script is:inline src="/js/paginacion-articulos.js"></script>

</BaseLayout>
