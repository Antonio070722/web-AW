﻿---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contacto">
    <div class="contSug">

        <div class="contact-header">
            <span class="contact-tag">Contacto</span>
            <h1>¿Hablamos?</h1>
            <p>¿Tienes ideas, mejoras o alguna duda? Estaré encantado de leerte y responderte.</p>
        </div>

        <div data-fs-success style="color: green; margin-bottom: 10px; text-align:center;"></div>
        <div data-fs-error style="color: red; margin-bottom: 10px; text-align:center;"></div>

        <form id="contact-form">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" data-fs-field placeholder="Tu nombre" required>
            <span data-fs-error="nombre" style="color: red; font-size: 0.8em;"></span>

            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" data-fs-field placeholder="tucorreo@ejemplo.com" required>
            <span data-fs-error="email" style="color: red; font-size: 0.8em;"></span>

            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" data-fs-field placeholder="Escribe tu mensaje aquí..." required></textarea>
            <span data-fs-error="mensaje" style="color: red; font-size: 0.8em;"></span>

            <button type="submit" data-fs-submit-btn>Enviar mensaje →</button>
        </form>

    </div>
    <button id="backToTop" class="back-to-top" aria-label="Volver arriba">↑</button>
</BaseLayout>

<script is:inline>
  window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
  formspree('initForm', { formElement: '#contact-form', formId: 'mrejrwqn' });
</script>
<script src="https://unpkg.com/@formspree/ajax@1" defer></script>

<style>
.contSug {
    max-width: 640px;
    margin: 0 auto;
    padding: 60px 24px;
}

.contact-header {
    text-align: center;
    margin-bottom: 40px;
}

.contact-tag {
    display: inline-block;
    background: #eff6ff;
    color: #0066ff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 40px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 16px;
}

.contact-header h1 {
    font-size: 2.4rem;
    font-weight: 700;
    color: #0a0a0a;
    margin-bottom: 12px;
}

.contact-header p {
    color: #475569;
    font-size: 1.05rem;
}
</style>