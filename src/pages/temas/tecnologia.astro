                <a href="../articulos/articulo1.html" style="color: #007bff; text-decoration: none;">Saber más</a>
            </div>
        </div>
    </div>
    <button id="backToTop" class="back-to-top" aria-label="Volver arriba">↑</button>
</BaseLayout>
    
