---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Temas">
    <div class="contenido">
    <a href="/" class="legal-tag">Inicio</a>
    <h1>Todos los temas</h1>

        <div class="themes-grid" style="margin-top: 30px;">
            <div class="tcard">
                <span class="tcard-icon">💻</span>
                <h2>Tecnología</h2>
                <p>Innovaciones que están cambiando el mundo, explicadas sin sensacionalismos y con ejemplos cotidianos.</p>
                <a href="/temas/tecnologia/" class="tcard-link">Ver artículos →</a>
            </div>

            <div class="tcard">
                <span class="tcard-icon">🧠</span>
                <h2>Inteligencia Artificial</h2>
                <p>Qué es la IA, cómo funciona y hacia dónde se dirige. Conceptos claros, sin tecnicismos innecesarios.</p>
                <a href="/temas/inteligencia-artificial-ia" class="tcard-link">Ver artículos →</a>
            </div>

            <div class="tcard" style="margin-bottom: 320px;">
                <span class="tcard-icon">🐍</span>
                <h2>Programación</h2>
                <p>Aprende a programar desde cero con guías prácticas de Java, ejemplos reales y trucos para avanzar rápido.</p>
                <a href="/temas/progr/" class="tcard-link">Ver artículos →</a>
            </div>
        </div>
    </div>

    <div class="hero-latest">
            <div class="latest-panel">
                <h2>📌 Últimos artículos</h2>
                        
            <div id="latest-articles"></div> <!--PARA MODIFICAR O AÑADIR ARTICULOS EN paginacion-articulos.js -->

            <div class="pagination">
                <button onclick="changePage(1)">1</button>
                <button onclick="changePage(2)">2</button>
                <button onclick="changePage(3)">3</button> 
                <!--<button onclick="changePage(4)">4</button> -->
            </div>
                        
        </div>
    </div>

    <button id="backToTop" class="back-to-top" aria-label="Volver arriba">↑</button>
    <script is:inline src="/js/paginacion-articulos.js"></script>
</BaseLayout>
<style>

    .contenido {
        padding: 20px; 
        background-color: #fff; 
    
    }

        .enlace-temas a {
    position: relative;
    padding-bottom: 20px;
    margin-bottom: 15px;
    color: #007bff; text-decoration: none;
}

.enlace-temas a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 60px; /* largo de la línea */
    height: 3px; /* grosor */
    background-color: #5678d6; 
    border-radius: 2px;
}

.themes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
}

.tcard {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 0.25s ease;
}

.tcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,102,255,0.08);
    border-color: #bfdbfe;
}

.tcard-icon {
    font-size: 2rem;
}

.tcard h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0a0a0a;
    margin: 0;
}

.tcard p {
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
    flex: 1;
    margin: 0;
}

.tcard-link {
    color: #0066ff;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    margin-top: 8px;
}

.tcard-link:hover {
    text-decoration: underline;
}

.tcard:last-child {
    grid-column: 1 / -1;
    max-width: 100%;
}
</style>