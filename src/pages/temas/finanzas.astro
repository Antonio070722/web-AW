---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Finanzas | AW Hub">
    <div slot="ticker" class="ticker-wrapper">
        <script type="module" src="https://widgets.tradingview-widget.com/w/es/tv-ticker-tape.js"></script>
        <tv-ticker-tape 
        symbols="FOREXCOM:SPXUSD,FOREXCOM:NSXUSD,FX:EURUSD,BITSTAMP:BTCUSD,BITSTAMP:ETHUSD,CMCMARKETS:GOLD,NASDAQ:TSLA,NASDAQ:MSFT,NASDAQ:AAPL,NASDAQ:META,CAPITALCOM:US100,BBG:EUR,SP:SPX,OANDA:NAS100USD" 
        show-hover>
        </tv-ticker-tape>
    </div>

    <div class="contFinan">
        <h1 style="text-align: center; display: inline-block;
    background: #f2f2f2; /* gris suave */
    padding: 8px 18px;
    border-radius: 6px; margin-top: -15px;">Artículos sobre finanzas</h1>
            <div class="enlace-temas">
                <a href="/temas/todosTemas">Todos los temas</a>
            </div>


        <div class="theme-content">
            <div class="theme-card" style="margin-top: 30px;">
                <h2>Inversiones para Principiantes</h2>
                <p>Consejos prácticos para comenzar a invertir con seguridad, entender el riesgo y construir una base financiera sólida.</p>
                <a href="../articulos/articulo3.html" style="color: #007bff; text-decoration: none;">Saber más</a>
            </div>
        </div>
    </div>
    <button id="backToTop" class="back-to-top" aria-label="Volver arriba">↑</button>
</BaseLayout>

<style>
    .enlace-temas a {
    position: relative;
    padding-bottom: 20px;
    margin-bottom: 15px;
    color: #007bff; text-decoration: none;
}

.enlace-temas a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 60px; /* largo de la línea */
    height: 3px; /* grosor */
    background-color: #5678d6; 
    border-radius: 2px;
}

.contFinan{
    padding: 20px; font-family: 'Poppins', sans-serif; background-color: #fff; color: #000;
}

.ticker-wrapper {
    width: 100%;
    margin: 0;
    padding: 0;
}

tv-ticker-tape {
    width: 100% !important;
    display: block;
}


</style>


